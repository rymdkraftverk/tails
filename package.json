{
  "name": "tails",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "qa": "npm test && npm run lint && npm run typecheck",
    "test": "npm test --prefix game && npm test --prefix controller",
    "lint": "eslint . && npm run lint --prefix controller",
